    {
      "label": "flash hello_world (J-Link)",
      "type": "shell",
      "command": "make flash",
      "dependsOn": "build hello_world",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    }
  ]
}
